! Regression run of the cool-core loop: the equilibrium (no eigenmode) on the
! cylindrical mesh at 64x16x16, to 0.5 tau_A.

 &usr_list
   rho_cgs     = 1.6727d-15            ! g cm^-3
   bc_gauss    = 10.0d0                ! G
   l_cgs       = 1.0d10                ! cm
   alpha       = 20.0d0
   rho_bg      = 0.6993006993d0        ! Legolas cte_rho0
   t_bg        = 2.255573870044d-3     ! Legolas cte_T0: 1.3e5 K
   t_core      = 1.577324384646d-3     ! Legolas p5: 9.09e4 K
   r_core      = 0.6d0                 ! Legolas p6
   w_core      = 0.4d0                 ! Legolas p7
   lambda_perp = 1.0d5                 ! Legolas lambda
   heating     = .true.
 /

 &filelist
   base_filename    = 'test'
   typefilelog      = 'special'
   autoconvert      = F
   convert_type     = 'vtuBCCmpi'
   saveprim         = T
   nwauxio          = 3
 /

 &savelist
   dtsave_log       = 0.1d0
   dtsave_dat       = 1e10
 /

 &stoplist
   time_max         = 0.5d0
 /

 &methodlist
   time_stepper    = 'threestep'
   flux_scheme     = 20*'hll'
   limiter         = 20*'vanleer'
   phys            = 'mhd'
 /

 &boundlist
   typeboundary_min1 = 8*'pole'
   typeboundary_max1 = 8*'special'
   typeboundary_min2 = 8*'periodic'
   typeboundary_max2 = 8*'periodic'
   typeboundary_min3 = 8*'periodic'
   typeboundary_max3 = 8*'periodic'
   specialboundary   = .true.
 /

 &meshlist
   geometry           = 'cylindrical'
   max_blocks         = 64
   refine_max_level   = 1
   block_nx1          = 16
   block_nx2          = 16
   block_nx3          = 8
   domain_nx1         = 64
   domain_nx2         = 16
   domain_nx3         = 16
   xprobmin1          =  0.0d0
   xprobmax1          =  1.0d0
   xprobmin2          =  0.0d0
   xprobmax2          =  6.283185307179586d0
   xprobmin3          =  0.0d0
   xprobmax3          =  1.0d0
 /

 &paramlist
   courantpar       = 0.4d0
 /

 &mhd_list
   mhd_gamma                                     = 1.6666666666666667d0
   He_abundance                                  = 0.0d0
   H_ion_fr                                      = 0.0d0
   mhd_radiative_cooling                         = .true.
   mhd_hyperbolic_thermal_conduction_anisotropic = .true.
   mhd_source_usr                                = .true.
   mhd_b0_split                                  = .true.
 /

 &rc_list
   coolcurve  = 'Rosner'
   coolmethod = 'exact'
   ncool      = 4000
   Tfix       = .false.
 /

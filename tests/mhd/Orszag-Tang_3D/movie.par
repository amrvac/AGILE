! Orszag-Tang vortex movie: shared settings for movie_<solver>.par.
! Run as  mpirun -np 8 ./agile -i movie.par movie_hllc.par
! (the second file sets flux_scheme and appends the solver to base_filename,
! giving movie/hllc_d3_...), then movie.py.

 &filelist
   base_filename    = 'movie/'
   autoconvert      = F
   slice_type       = 'dat'
 /

 &savelist
   itsave(1,3)      = 0
   dtsave_log       = 0.1d0
   dtsave_dat       = 1e10
   dtsave_slice     = 0.01d0
   nslices          = 1
   slicedir(1)      = 3
   slicecoord(1)    = 0.017578125d0
 /

 &stoplist
   time_max = 1.0d0
 /

 &methodlist
   time_stepper    = 'threestep'
   flux_scheme     = 20*'tvdlf'
   limiter         = 20*'koren'
   phys            = 'mhd'
 /

 &boundlist
   typeboundary_min1 = 8*'periodic'
   typeboundary_max1 = 8*'periodic'
   typeboundary_min2 = 8*'periodic'
   typeboundary_max2 = 8*'periodic'
   typeboundary_min3 = 8*'periodic'
   typeboundary_max3 = 8*'periodic'
 /

 &meshlist
   max_blocks         = 256
   refine_max_level   = 1
   block_nx1          = 16
   block_nx2          = 16
   block_nx3          = 8
   domain_nx1         = 256
   domain_nx2         = 256
   domain_nx3         = 8
   xprobmin1       = 0.0d0
   xprobmax1       = 1.0d0
   xprobmin2       = 0.0d0
   xprobmax2       = 1.0d0
   xprobmin3       = 0.0d0
   xprobmax3       = 0.03125d0
 /

 &paramlist
   slowsteps        = 10
   courantpar       = 0.7d0
   typecourant      = 'maxsum'
 /

 &mhd_list
   mhd_gravity = .false.
 /

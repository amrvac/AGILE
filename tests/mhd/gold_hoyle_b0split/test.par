! Regression run of the B0-split rope: a coarse box to 2 tau_A.
! The 'special' log carries the equilibrium diagnostics (Ekin, vmax, dB_L2,
! sigmaJ, ...), so the regression compares those rather than mean(w).

 &usr_list
   setup  = 'rope'
   rho0   = 1.0d0
   b0     = 1.0d0
   beta   = 0.1d0
   qtwist = 1.0d0
 /

 &filelist
   base_filename    = 'test'
   typefilelog      = 'special'
   autoconvert      = F
 /

 &savelist
   itsave(1,1)      = 0
   dtsave_log       = 0.5d0
   dtsave_dat       = 1e10
 /

 &stoplist
   time_max         = 2.0d0
 /

 &methodlist
   time_stepper    = 'threestep'
   flux_scheme     = 20*'hll'
   limiter         = 20*'vanleer'
   phys            = 'mhd'
 /

 &boundlist
   typeboundary_min1 = 8*'special'
   typeboundary_max1 = 8*'special'
   typeboundary_min2 = 8*'special'
   typeboundary_max2 = 8*'special'
   typeboundary_min3 = 8*'periodic'
   typeboundary_max3 = 8*'periodic'
   specialboundary   = .true.
 /

 &meshlist
   max_blocks         = 64
   refine_max_level   = 1
   block_nx1          = 8
   block_nx2          = 8
   block_nx3          = 8
   domain_nx1         = 32
   domain_nx2         = 32
   domain_nx3         = 8
   xprobmin1          = -4.0d0
   xprobmax1          =  4.0d0
   xprobmin2          = -4.0d0
   xprobmax2          =  4.0d0
   xprobmin3          =  0.0d0
   xprobmax3          =  1.0d0
 /

 &paramlist
   courantpar       = 0.4d0
 /

 &mhd_list
   mhd_b0_split = .true.
 /

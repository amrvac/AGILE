! Gaussian pressure bump on the periodic force-free field (cos kz, sin kz, 0). tests/mhd/gold_hoyle
! evolves B, tests/mhd/gold_hoyle_b0split evolves B1 on B0 = the uniform field;
! the two differ only in the numerical dissipation and converge together.

 &usr_list
   setup  = 'helix'
   rho0   = 1.0d0
   b0     = 1.0d0
   beta   = 0.1d0
   pbump  = 0.05d0
   rbump  = 0.5d0
 /

 &filelist
   base_filename    = 'output/helix'
   typefilelog      = 'special'
   autoconvert      = F
 /

 &savelist
   itsave(1,1)      = 0
   dtsave_log       = 0.1d0
   dtsave_dat       = 1e10
 /

 &stoplist
   time_max         = 1.0d0
 /

 &methodlist
   time_stepper    = 'threestep'
   flux_scheme     = 20*'hll'
   limiter         = 20*'vanleer'
   phys            = 'mhd'
 /

 &boundlist
   typeboundary_min1 = 8*'periodic'
   typeboundary_max1 = 8*'periodic'
   typeboundary_min2 = 8*'periodic'
   typeboundary_max2 = 8*'periodic'
   typeboundary_min3 = 8*'periodic'
   typeboundary_max3 = 8*'periodic'
 /

 &meshlist
   max_blocks         = 512
   refine_max_level   = 1
   block_nx1          = 16
   block_nx2          = 16
   block_nx3          = 16
   domain_nx1         = 128
   domain_nx2         = 128
   domain_nx3         = 32
   xprobmin1          = -4.0d0
   xprobmax1          =  4.0d0
   xprobmin2          = -4.0d0
   xprobmax2          =  4.0d0
   xprobmin3          =  0.0d0
   xprobmax3          =  1.0d0
 /

 &paramlist
   courantpar       = 0.4d0
 /

 &mhd_list
   mhd_b0_split = .true.
 /

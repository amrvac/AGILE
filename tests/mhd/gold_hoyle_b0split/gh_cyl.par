! Gold-Hoyle force-free flux rope on the cylindrical (r, z, phi) mesh,
! through the axis. The equilibrium is a function of r alone, so what is
! under test here is the balance of the magnetic pressure flux against the
! hoop-stress source term, at the axis included.
!
! This is a different build from agile.par (geometry is compile-time):
!   make clean && make CONFIG=gh_cyl.par && mpirun -np 4 ./agile -i gh_cyl.par
!
! Same units as agile.par: a = v_A = tau_A = 1, rope length 1 a, twist 1 rad.

 &usr_list
   setup  = 'rope'
   rho0   = 1.0d0
   b0     = 1.0d0
   beta   = 0.1d0
   qtwist = 1.0d0
 /

 &filelist
   base_filename    = 'output/gh_cyl'
   typefilelog      = 'special'
   autoconvert      = F
   convert_type     = 'vtuBCCmpi'
   saveprim         = T
   nwauxio          = 3
 /

 &savelist
   itsave(1,1)      = 0
   itsave(1,2)      = 0
   dtsave_log       = 0.5d0
   dtsave_dat       = 1e10
 /

 &stoplist
   time_max         = 2.0d0
 /

 &methodlist
   time_stepper    = 'threestep'
   flux_scheme     = 20*'hll'
   limiter         = 20*'vanleer'
   phys            = 'mhd'
 /

 &boundlist
   ! The axis is 'pole': its ghost cells come from the block half a turn
   ! away in phi, which needs phi periodic over a full turn and an even
   ! number of level-1 blocks across phi. The outer radius holds the exact
   ! equilibrium; z is periodic along the rope.
   typeboundary_min1 = 8*'pole'
   typeboundary_max1 = 8*'special'
   typeboundary_min2 = 8*'periodic'
   typeboundary_max2 = 8*'periodic'
   typeboundary_min3 = 8*'periodic'
   typeboundary_max3 = 8*'periodic'
   specialboundary   = .true.
 /

 &meshlist
   ! phi (dim3) is in units of 2*pi: [0, 1] is the full turn
   geometry           = 'cylindrical'
   max_blocks         = 4096
   refine_max_level   = 1
   block_nx1          = 8
   block_nx2          = 8
   block_nx3          = 8
   domain_nx1         = 64
   domain_nx2         = 8
   domain_nx3         = 16
   xprobmin1          =  0.0d0
   xprobmax1          =  4.0d0
   xprobmin2          =  0.0d0
   xprobmax2          =  1.0d0
   xprobmin3          =  0.0d0
   xprobmax3          =  1.0d0
 /

 &paramlist
   courantpar       = 0.4d0
 /

 &mhd_list
   mhd_b0_split = .true.
 /

 ! Overlay on test.par for the restart test in test.make: write restart
 ! files at t = 0.05 and t = 0.1 with the parallel path. (hd/spherical's
 ! pario test covers several collective rounds and records of different
 ! sizes.)
 &filelist
   base_filename = '_restart'
   datfile_parallel_io = .true.
 /

 &savelist
   dtsave_dat = 0.05d0
 /

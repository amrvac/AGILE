 &filelist
   base_filename    = 'blast'
   autoconvert      = T
   convert_type     = 'vtuBCCmpi'
   slice_type       = 'vtuCC'
   saveprim         = T
   ! nocartesian is .false. by default, so the VTU carries Cartesian cell
   ! corners and Cartesian vector components rather than (r, z, phi) ones,
   ! which is what a viewer such as ParaView or VisIt wants for a wedge.
 /

 &savelist
   itsave(1,1)      = 0        ! also dump the initial log
   itsave(1,2)      = 0        ! also dump the initial condition
   itsave(1,3)      = 0        ! ... and the initial slices
   ditsave_log      = 10
   dtsave_dat       = 0.025d0
   dtsave_slice     = 0.0025d0

   ! Three slices through the centre of the hot spot, one per coordinate
   ! direction: a cylindrical shell at its radius, a z = const plane and a
   ! meridional plane at its azimuth.
   !
   ! CAUTION: unlike xprobmin3/xprobmax3 in &meshlist, slicecoord is in code
   ! units, so the phi slice below is in RADIANS. The values are the centre
   ! that mod_usr.fpp derives from the domain, i.e.
   !   r   = xprobmin1 + 0.45*(xprobmax1-xprobmin1) = 1.45
   !   z   = xprobmin2 + 0.40*(xprobmax2-xprobmin2) = 0.4
   !   phi = xprobmin3 + 0.40*(xprobmax3-xprobmin3) = 0.20*pi
   ! Keep them in step with fr/fz/fphi if you move the blast.
   nslices          = 3
   slicedir(1)      = 1
   slicecoord(1)    = 1.45d0
   slicedir(2)      = 2
   slicecoord(2)    = 0.4d0
   slicedir(3)      = 3
   slicecoord(3)    = 0.6283185307179586d0
 /

 &stoplist
   time_max         = 0.025d0
 /

 &methodlist
   time_stepper    = 'threestep'
   flux_scheme     = 20*'tvdlf'
   limiter         = 20*'vanleer'
   phys            = 'ffhd'
 /

 &boundlist
   typeboundary_min1 = 3*'cont'
   typeboundary_max1 = 3*'cont'
   typeboundary_min2 = 3*'cont'
   typeboundary_max2 = 3*'cont'
   typeboundary_min3 = 3*'cont'
   typeboundary_max3 = 3*'cont'
 /

 &meshlist
   ! NOTE: phi (dim3) is given in units of 2*pi, so it runs over [0, pi/2]
   ! below; z (dim2) is a plain length. The domain deliberately stays away
   ! from the cylindrical axis r = 0.
   geometry           = 'cylindrical'
   max_blocks         =  4096
   refine_max_level   =  3
   w_refine_weight    =  0.1d0, 0.0d0, 0.9d0
   block_nx1          =  8
   block_nx2          =  8
   block_nx3          =  8
   domain_nx1         =  32
   domain_nx2         =  32
   domain_nx3         =  32
   xprobmin1          =  1.0d0
   xprobmax1          =  2.0d0
   xprobmin2          =  0.0d0
   xprobmax2          =  1.0d0
   xprobmin3          =  0.0d0
   xprobmax3          =  0.25d0
 /

 &paramlist
   slowsteps        = 10
   courantpar       = 0.4d0
 /

 &ffhd_list
   ffhd_gravity                       = .false.
   ffhd_hyperbolic_thermal_conduction = .false.
   ffhd_radiative_cooling             = .false.
   ffhd_source_usr                    = .false.
 /

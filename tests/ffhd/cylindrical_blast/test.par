 &filelist
   base_filename    = 'test'
   typefilelog      = 'regression_test'
   autoconvert      = F
 /

 &savelist
   dtsave_log       = 1e10
   dtsave_dat       = 1e10
 /

 &stoplist
   time_max         = 0.025d0
 /

 &methodlist
   time_stepper    = 'threestep'
   flux_scheme     = 20*'tvdlf'
   limiter         = 20*'vanleer'
   phys            = 'ffhd'
 /

 &boundlist
   typeboundary_min1 = 3*'cont'
   typeboundary_max1 = 3*'cont'
   typeboundary_min2 = 3*'cont'
   typeboundary_max2 = 3*'cont'
   typeboundary_min3 = 3*'cont'
   typeboundary_max3 = 3*'cont'
 /

 &meshlist
   ! NOTE: phi (dim3) is given in units of 2*pi, so it runs over [0, pi/2]
   ! below; z (dim2) is a plain length. The domain deliberately stays away
   ! from the cylindrical axis r = 0.
   geometry           = 'cylindrical'
   max_blocks         =  4096
   refine_max_level   =  1
   block_nx1          =  8
   block_nx2          =  8
   block_nx3          =  8
   domain_nx1         =  32
   domain_nx2         =  32
   domain_nx3         =  32
   xprobmin1          =  1.0d0
   xprobmax1          =  2.0d0
   xprobmin2          =  0.0d0
   xprobmax2          =  1.0d0
   xprobmin3          =  0.0d0
   xprobmax3          =  0.25d0
 /

 &paramlist
   slowsteps        = 10
   courantpar       = 0.4d0
 /

 &ffhd_list
   ffhd_gravity                       = .false.
   ffhd_hyperbolic_thermal_conduction = .false.
   ffhd_radiative_cooling             = .false.
   ffhd_source_usr                    = .false.
 /

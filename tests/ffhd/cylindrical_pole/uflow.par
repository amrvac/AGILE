! agile.par is what the build reads: make/config_reader.py takes the
! compile-time parameters from this file alone. There is only one run here
! (uflow.par); this file is kept in step with it. See test.make.

 &filelist
   base_filename    = 'uflow'
   typefilelog      = 'regression_test'
   autoconvert      = F
 /

 &savelist
   dtsave_log       = 1e10
   dtsave_dat       = 1e10
 /

 &stoplist
   time_max         = 0.1d0
 /

 &methodlist
   time_stepper    = 'threestep'
   flux_scheme     = 20*'tvdlf'
   limiter         = 20*'vanleer'
   phys            = 'ffhd'
 /

 &boundlist
   ! r = 0 is the axis ('pole'): every ffhd conserved variable is a scalar so
   ! read_par_files makes them all symm, and getbc fills the axis ghost cells
   ! from the block half a revolution away in phi (which must be periodic over
   ! a full turn). The outer r face and both z faces are held at the exact
   ! solution ('special'). The frozen field is re-derived by
   ! fill_nwextra_device, not covered by typeboundary or getbc.
   typeboundary_min1 = 3*'pole'
   typeboundary_max1 = 3*'special'
   typeboundary_min2 = 3*'special'
   typeboundary_max2 = 3*'special'
   typeboundary_min3 = 3*'periodic'
   typeboundary_max3 = 3*'periodic'
   specialboundary   = .true.
 /

 &meshlist
   ! 3D cylindrical is (r, z, phi): only phi is angular, so only xprobmin3 and
   ! xprobmax3 are in units of 2*pi and the full turn below is [0, 2*pi]. r
   ! starts at 0, so this domain deliberately runs onto the cylindrical axis.
   ! The number of level-1 blocks across phi (domain_nx3/block_nx3 = 2) has to
   ! be even, because the block on the far side of the axis is found by
   ! shifting the phi block index by half of it.
   geometry           = 'cylindrical'
   max_blocks         =  4096
   refine_max_level   =  1
   block_nx1          =  8
   block_nx2          =  8
   block_nx3          =  8
   domain_nx1         =  16
   domain_nx2         =  16
   domain_nx3         =  16
   xprobmin1          =  0.0d0
   xprobmax1          =  1.0d0
   xprobmin2          =  0.0d0
   xprobmax2          =  1.0d0
   xprobmin3          =  0.0d0
   xprobmax3          =  1.0d0
 /

 &paramlist
   courantpar       = 0.4d0
 /

 &ffhd_list
   ffhd_gravity                       = .false.
   ffhd_hyperbolic_thermal_conduction = .false.
   ffhd_radiative_cooling             = .false.
   ffhd_source_usr                    = .false.
 /

 &usr_list
   ! Which initial condition this run uses; see mod_usr.fpp.
   ! Everything else about the build is shared with the other par
   ! files in this directory.
   setup = 'blast'
 /

 &filelist
   base_filename    = 'blast_amr'
   typefilelog      = 'regression_test'
   autoconvert      = F
 /

 &savelist
   dtsave_log       = 1e10
   dtsave_dat       = 1e10
 /

 &stoplist
   time_max         = 0.025d0
 /

 &methodlist
   time_stepper    = 'threestep'
   flux_scheme     = 20*'tvdlf'
   limiter         = 20*'vanleer'
   phys            = 'ffhd'
 /

 &boundlist
   typeboundary_min1 = 3*'cont'
   typeboundary_max1 = 3*'cont'
   typeboundary_min2 = 3*'cont'
   typeboundary_max2 = 3*'cont'
   typeboundary_min3 = 3*'cont'
   typeboundary_max3 = 3*'cont'
 /

 &meshlist
   ! The AMR counterpart of blast.par, and the only AMR case in the tree that
   ! runs phys = 'ffhd'. That is the point of it: ffhd is the one physics with
   ! nwextra > 0, so nwgc < nw, and it is therefore the only case that
   ! exercises the AMR block transfers at their reduced width. The frozen
   ! field b1,b2,b3 is never on the wire at all - fill_nwextra_device
   ! re-derives it from usr_set_nwextra in alloc_node for every block that
   ! comes into existence, refined children, coarsened parents and blocks
   ! arriving from another rank alike - so a refined run is what checks that
   ! the extras really are reconstructed rather than carried.
   !
   ! NOTE: angular coordinates (theta, phi here) are given in units of 2*pi,
   ! so theta runs over [pi/4, 3pi/4] and phi over [0, pi/2] below. The domain
   ! deliberately stays away from the polar axis and from r = 0.
   geometry           = 'spherical'
   max_blocks         =  4096

   ! Three levels, refined on density and energy by the default Lohner
   ! estimator (refine_criterion = 3). The weights are indexed by the ffhd
   ! variable order rho, m_par, e, b1, b2, b3: the frozen field carries no
   ! weight, since it is analytic and would say nothing about the solution.
   refine_max_level   =  3
   w_refine_weight    =  0.1d0, 0.0d0, 0.9d0, 0.0d0, 0.0d0, 0.0d0

   block_nx1          =  8
   block_nx2          =  8
   block_nx3          =  8
   domain_nx1         =  32
   domain_nx2         =  32
   domain_nx3         =  32
   xprobmin1          =  1.0d0
   xprobmax1          =  2.0d0
   xprobmin2          =  0.125d0
   xprobmax2          =  0.375d0
   xprobmin3          =  0.0d0
   xprobmax3          =  0.25d0
 /

 &paramlist
   slowsteps        = 10
   courantpar       = 0.4d0
 /

 &ffhd_list
   ffhd_gravity                       = .false.
   ffhd_hyperbolic_thermal_conduction = .false.
   ffhd_radiative_cooling             = .false.
   ffhd_source_usr                    = .false.
 /

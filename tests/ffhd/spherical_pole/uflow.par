! agile.par is what the build reads: make/config_reader.py takes the
! compile-time parameters from this file alone. There is only one run here
! (uflow.par); this file is kept in step with it so `./agile -i agile.par`
! does the same thing. See test.make.

 &filelist
   base_filename    = 'uflow'
   typefilelog      = 'regression_test'
   autoconvert      = F
 /

 &savelist
   dtsave_log       = 1e10
   dtsave_dat       = 1e10
 /

 &stoplist
   time_max         = 0.1d0
 /

 &methodlist
   time_stepper    = 'threestep'
   flux_scheme     = 20*'tvdlf'
   limiter         = 20*'vanleer'
   phys            = 'ffhd'
 /

 &boundlist
   ! The r boundaries are held at the exact solution ('special'). The axis
   ! faces are 'pole': read_par_files turns that into per-variable symm entries
   ! (every ffhd conserved variable is a scalar, so all symmetric), and getbc
   ! fills those ghost cells from the block half a revolution away in phi. That
   ! only works if phi is periodic over a full turn, hence 'periodic' below.
   ! The frozen field is not covered by typeboundary or getbc at all;
   ! fill_frozen_field_device re-derives it in every ghost cell.
   typeboundary_min1 = 3*'special'
   typeboundary_max1 = 3*'special'
   typeboundary_min2 = 3*'pole'
   typeboundary_max2 = 3*'pole'
   typeboundary_min3 = 3*'periodic'
   typeboundary_max3 = 3*'periodic'
   specialboundary   = .true.
 /

 &meshlist
   ! NOTE: angular coordinates are given in units of 2*pi, so theta runs over
   ! the full [0, pi] and phi over the full [0, 2*pi]. The domain deliberately
   ! runs onto the polar axis at both ends. The number of level-1 blocks across
   ! phi (domain_nx3/block_nx3 = 2) has to be even, because the block on the
   ! far side of a pole is found by shifting the phi block index by half of it.
   geometry           = 'spherical'
   max_blocks         =  4096
   refine_max_level   =  1
   block_nx1          =  8
   block_nx2          =  8
   block_nx3          =  8
   domain_nx1         =  16
   domain_nx2         =  16
   domain_nx3         =  16
   xprobmin1          =  1.0d0
   xprobmax1          =  2.0d0
   xprobmin2          =  0.0d0
   xprobmax2          =  0.5d0
   xprobmin3          =  0.0d0
   xprobmax3          =  1.0d0
 /

 &paramlist
   courantpar       = 0.4d0
 /

 &ffhd_list
   ffhd_gravity                       = .false.
   ffhd_hyperbolic_thermal_conduction = .false.
   ffhd_radiative_cooling             = .false.
   ffhd_source_usr                    = .false.
 /

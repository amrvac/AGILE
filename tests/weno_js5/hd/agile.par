&filelist
 base_filename='solution'
 typefilelog='special'
 autoconvert=F
/
&savelist
 itsave(1,1)=0
 itsave(1,2)=0
 dtsave_log=1.d10
 dtsave_dat=1.d10
/
&stoplist
 time_max=0.01d0
/
&methodlist
 phys='hd'
 time_stepper='threestep'
 limiter=20*'weno5'
 flux_scheme=20*'hllc'
/
&boundlist
 typeboundary_min1=5*'periodic'
 typeboundary_max1=5*'periodic'
 typeboundary_min2=5*'periodic'
 typeboundary_max2=5*'periodic'
 typeboundary_min3=5*'periodic'
 typeboundary_max3=5*'periodic'
/
&meshlist
 max_blocks=128
 refine_max_level=1
 refine_usr=T
 refine_criterion=1
 block_nx1=16
 block_nx2=8
 block_nx3=8
 domain_nx1=64
 domain_nx2=8
 domain_nx3=8
 xprobmin1=0.d0
 xprobmin2=0.d0
 xprobmin3=0.d0
 xprobmax1=1.d0
 xprobmax2=1.d0
 xprobmax3=1.d0
 iprob=1
/
&paramlist
 courantpar=0.3d0
 dtpar=0.0001d0
/
&hd_list
 hd_gamma=1.4d0
/

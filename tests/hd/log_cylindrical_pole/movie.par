! A longer, visualisable run of the same blast-across-the-axis setup as
! blast_amr.par, for making a movie and for watching conservation. The
! uniformly spaced counterpart is tests/hd/cylindrical_pole/movie.par, and the
! spherical one tests/hd/spherical_pole/movie.par.
!
! Four things differ from agile.par and blast_amr.par on purpose:
!
!  * the domain is much wider - r in [0, 2.4] rather than [0, 1] and z in
!    [-0.7, 1.7] rather than [0, 1] - so the shell has room to expand across
!    the axis, wrap around the far side and move well out into the domain for
!    the whole run without reaching the open r or z boundaries. The hot spot
!    still starts at (r_c, z_c) = (0.3, 0.5), phi_c = pi/2.
!
!  * the radial mesh is the offset logarithmic one, uniform in
!    s = ln(1 + r/r0) with r0 = log_r0 = 0.2 as everywhere else in this
!    directory. Over 24 level-one cells that runs the cell width from 0.023 at
!    the axis to 0.264 at r = 2.4, a factor of 11.7. The uniform movie run has
!    dr = 0.1 throughout, so this grid is *finer* everywhere inside r = 0.74
!    and coarser only further out, where the shell is weak - and the hot spot,
!    which spans r in [0.1, 0.5], sits wholly in the finer part. Three levels
!    of refinement then bring the shell itself down by a further factor of
!    four.
!
!    That the mesh reaches r = 0 at all is what log_r0 buys: the plain
!    s = ln(r) of the other log_* directories has no value at the axis. The
!    price is the timestep - the smallest cell is about four times narrower
!    than the uniform run's, and ds(3) = r*dphi shrinks with it - so this run
!    takes several times as many steps as tests/hd/cylindrical_pole/movie.par
!    for the same physical time.
!
!  * it runs to t = 0.3, about seven times blast_amr.par's t = 0.04 - long
!    enough for the shell to cross the axis and expand out into the domain.
!
!  * it dumps .vtu snapshots and slices for ParaView/VisIt instead of the
!    regression log. Both carry Cartesian cell corners and Cartesian vector
!    components (nocartesian is .false. by default), which is what ParaView
!    and VisIt want across the axis. The corner grid comes from calc_x, which
!    maps the logical radial coordinate back with r_of_s, so the .vtu cells
!    are the stretched ones and not a uniformly spaced impostor.
!
! The volume averages in the log are a rough conservation diagnostic only: the
! r and z boundaries are open and fix_conserve is disabled at refinement
! boundaries, so do not read the drift as a tight conservation test.
!
! Run it with, from this directory, after building for the GPU
!   make -j4 arch=nvidia OPENACC=1 NOGPUDIRECT=1
! then
!   mkdir -p movie && mpirun -np 1 ./agile -i movie.par

 &usr_list
   setup = 'blast'
 /

 &filelist
   base_filename    = 'movie/logcylblast'
   autoconvert      = T
   convert_type     = 'vtuBCCmpi'
   slice_type       = 'vtuCC'
   saveprim         = T
 /

 &savelist
   itsave(1,1)      = 0        ! also dump the initial log
   itsave(1,2)      = 0        ! ... the initial condition
   itsave(1,3)      = 0        ! ... and the initial slices
   ditsave_log      = 100      ! the conservation trace, every 100th step
   dtsave_dat       = 0.0075d0 ! 40 snapshots
   dtsave_slice     = 0.003d0  ! 100 movie frames

   ! Four slices. The two meridional half-planes at phi_c and phi_c + pi
   ! together make the full plane through the axis containing the blast centre
   ! - that is the view in which the shell is seen to cross the axis. The
   ! constant-r shell and the constant-z plane show the same crossing from the
   ! other two directions.
   !
   ! CAUTION: unlike xprobmin3/xprobmax3 in &meshlist, slicecoord is in code
   ! units, so the phi angles are RADIANS. phi_c = 0.5*pi is the azimuth of
   ! the hot spot set in mod_usr.fpp; keep the two in step.
   !
   ! slicecoord(3) is a *physical* radius, and stays one under LOG_RADIUS:
   ! only get_igslice, which turns a position into a block index, takes the
   ! logarithm, because fill_subnode picks the cell inside the block by
   ! comparing against ps(igrid)%x, which is physical.
   nslices          = 4
   slicedir(1)      = 3
   slicecoord(1)    = 1.5707963267948966d0   ! phi = phi_c        = pi/2
   slicedir(2)      = 3
   slicecoord(2)    = 4.7123889803846899d0   ! phi = phi_c + pi   = 3pi/2
   slicedir(3)      = 1
   slicecoord(3)    = 0.3d0                  ! r = r_c, the shell of the spot
   slicedir(4)      = 2
   slicecoord(4)    = 0.5d0                  ! z = z_c, through the spot centre
 /

 &stoplist
   time_max         = 0.3d0
 /

 &methodlist
   time_stepper    = 'threestep'
   flux_scheme     = 20*'hll'
   limiter         = 20*'vanleer'
   phys            = 'hd'
 /

 &boundlist
   ! r = 0 is the axis ('pole'); the outer r face and both z faces are open
   ! ('cont'), now far enough away that the shell does not reach them; phi is
   ! periodic over a full turn.
   typeboundary_min1 = 5*'pole'
   typeboundary_max1 = 5*'cont'
   typeboundary_min2 = 5*'cont'
   typeboundary_max2 = 5*'cont'
   typeboundary_min3 = 5*'periodic'
   typeboundary_max3 = 5*'periodic'
 /

 &meshlist
   ! xprobmin1/xprobmax1 are physical radii; read_par_files converts them to
   ! the logical coordinate s = ln(1 + r/log_r0). xprobmin1 = 0 is legal
   ! precisely because log_r0 > 0.
   geometry           = 'logCylindrical'
   log_r0             =  0.2d0
   max_blocks         =  2048
   refine_max_level   =  3
   w_refine_weight    =  0.1d0, 0.0d0, 0.0d0, 0.0d0, 0.9d0
   block_nx1          =  8
   block_nx2          =  8
   block_nx3          =  8
   domain_nx1         =  24
   domain_nx2         =  24
   domain_nx3         =  16
   xprobmin1          =  0.0d0
   xprobmax1          =  2.4d0
   xprobmin2          = -0.7d0
   xprobmax2          =  1.7d0
   xprobmin3          =  0.0d0
   xprobmax3          =  1.0d0
 /

 &paramlist
   slowsteps        = 10
   courantpar       = 0.4d0
 /

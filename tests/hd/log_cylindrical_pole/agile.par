! agile.par is what the build reads. make/config_reader.py takes the
! compile-time parameters from *this* file alone and turns them into
! config.mk, so it has to declare the union of what every par file in this
! directory needs: geometry, phys, specialboundary and refine_usr. The other
! par files may switch specialboundary and refine_usr off again at run time -
! those two are runtime logicals as well as fypp defines - but the routines
! they guard have to be compiled in either way.
!
! Running `./agile -i agile.par` on its own does the uniform-flow case; the
! test suite runs uflow.par, uflow_amr.par and blast_amr.par instead, all
! against this one build. See test.make.

 &usr_list
   setup = 'uniform'
 /

 &filelist
   base_filename    = 'uflow'
   autoconvert      = F
 /

 &savelist
   dtsave_log       = 1e10
   dtsave_dat       = 1e10
 /

 &stoplist
   time_max         = 0.1d0
 /

 &methodlist
   time_stepper    = 'threestep'
   flux_scheme     = 20*'hll'
   limiter         = 20*'vanleer'
   phys            = 'hd'
 /

 &boundlist
   ! The r boundaries are ordinary open boundaries held at the exact solution.
   ! The axis faces are 'pole': read_par_files turns that into per-variable
   ! symm/asymm entries, and getbc fills those ghost cells from the block half
   ! a revolution away in phi rather than from a boundary condition. That only
   ! works if phi itself is periodic over a full turn, hence 'periodic' below.
   typeboundary_min1 = 5*'pole'
   typeboundary_max1 = 5*'special'
   typeboundary_min2 = 5*'special'
   typeboundary_max2 = 5*'special'
   typeboundary_min3 = 5*'periodic'
   typeboundary_max3 = 5*'periodic'
   specialboundary   = .true.
 /

 &meshlist
   ! 3D cylindrical is (r, z, phi): only phi is angular, so only xprobmin3 and
   ! xprobmax3 are in units of 2*pi and the full turn below is [0, 2*pi]. r
   ! starts at 0, so this domain deliberately runs onto the cylindrical axis.
   ! The number of level-1 blocks across phi (domain_nx3/block_nx3 = 2) has to
   ! be even, because the block on the far side of the axis is found by
   ! shifting the phi block index by half of it.
   !
   ! The radial mesh is uniform in the logical coordinate s = ln(1 + r/r0)
   ! rather than in r. r0 is log_r0 below; the plain s = ln(r) of the other
   ! log_* directories is log_r0 = 0, which cannot reach r = 0. With r0 = 0.2
   ! on this domain the cell width runs from 0.024 at the axis to 0.127 at
   ! r = 1, a factor of 5.4, so the stretching is real and not nominal - and
   ! the mesh is uniform, not logarithmic, in the innermost few cells, which
   ! is the point of the offset.
   !
   ! xprobmin1/xprobmax1 are *physical* radii here; read_par_files converts
   ! them to the logical coordinate. A mod_usr that wants a physical radius
   ! back out of them has to apply r_of_s - see check_blast_fits.
   geometry           = 'logCylindrical'
   log_r0             =  0.2d0
   max_blocks         =  4096
   refine_max_level   =  1
   refine_usr         =  .true. ! compiled in for uflow_amr.par
   block_nx1          =  8
   block_nx2          =  8
   block_nx3          =  8
   domain_nx1         =  16
   domain_nx2         =  16
   domain_nx3         =  16
   xprobmin1          =  0.0d0
   xprobmax1          =  1.0d0
   xprobmin2          =  0.0d0
   xprobmax2          =  1.0d0
   xprobmin3          =  0.0d0
   xprobmax3          =  1.0d0
 /

 &paramlist
   courantpar       = 0.4d0
 /

 &usr_list
   ! Which initial condition this run uses; see mod_usr.fpp. Everything else
   ! about the build is shared with the other par files in this directory.
   setup = 'uniform'
 /

 &filelist
   base_filename    = 'uflow_amr'
   typefilelog      = 'regression_test'
   autoconvert      = F
 /

 &savelist
   dtsave_log       = 1e10
   dtsave_dat       = 1e10
 /

 &stoplist
   time_max         = 0.1d0
 /

 &methodlist
   time_stepper    = 'threestep'
   flux_scheme     = 20*'hll'
   limiter         = 20*'vanleer'
   phys            = 'hd'
 /

 &boundlist
   ! The axis faces are 'pole': read_par_files turns that into per-variable
   ! symm/asymm entries, and getbc fills those ghost cells from the block half
   ! a revolution away in phi rather than from a boundary condition. That only
   ! works if phi itself is periodic over a full turn, hence 'periodic' below.
   typeboundary_min1 = 5*'special'
   typeboundary_max1 = 5*'special'
   typeboundary_min2 = 5*'pole'
   typeboundary_max2 = 5*'pole'
   typeboundary_min3 = 5*'periodic'
   typeboundary_max3 = 5*'periodic'
   specialboundary   = .true.
 /

 &meshlist
   ! NOTE: angular coordinates are given in units of 2*pi, so theta runs over
   ! the full [0, pi] and phi over the full [0, 2*pi]. The domain deliberately
   ! runs onto the polar axis at both ends. The number of level-1 blocks across
   ! phi (domain_nx3/block_nx3 = 2) has to be even, because the block on the
   ! far side of a pole is found by shifting the phi block index by half of it.
   geometry           = 'spherical'
   max_blocks         =  4096
   block_nx1          =  8
   block_nx2          =  8
   block_nx3          =  8
   domain_nx1         =  16
   domain_nx2         =  16
   domain_nx3         =  16
   xprobmin2          =  0.0d0
   xprobmax2          =  0.5d0
   xprobmin3          =  0.0d0
   xprobmax3          =  1.0d0
   ! Two levels, the refined region a half-turn wedge in phi (see
   ! usr_refine_grid), so that a block touching the axis on one side meets a
   ! block of the other level across it. That is what puts the restricting and
   ! prolonging pole paths under test; a single-level run only ever exercises
   ! the same-level one.
   refine_max_level   =  2
   refine_criterion   =  1 ! refinement comes solely from usr_refine_grid
   refine_usr         =  .true.
   xprobmin1          =  1.0d0
   xprobmax1          =  2.0d0
 /

 &paramlist
   courantpar       = 0.4d0
 /

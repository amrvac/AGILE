 &filelist
   base_filename    = 'uflow'
   autoconvert      = T
   convert_type     = 'vtuBCCmpi'
   slice_type       = 'vtuCC'
   saveprim         = T
   ! nocartesian is .false. by default, so the VTU carries Cartesian cell
   ! corners and Cartesian vector components. For this case that is what you
   ! want to look at: v1/v2/v3 should come out as the constant Cartesian
   ! (1.0, 0.5, -0.3) everywhere, and rho as a flat 1.0. What is worth
   ! inspecting is where they fail to, i.e. where the truncation error lives.
 /

 &savelist
   itsave(1,2)      = 0        ! also dump the initial condition
   itsave(1,3)      = 0        ! ... and the initial slice
   ditsave_log      = 1        ! the per-step drift of mean(rho) is the point
   dtsave_dat       = 0.01d0
   dtsave_slice     = 0.01d0

   ! One meridional plane through the middle of the wedge. As in &meshlist the
   ! angular domain bounds are in units of 2*pi, but slicecoord is in code
   ! units, so this is RADIANS: 0.25*pi is the mid-azimuth of phi in [0, pi/2].
   nslices          = 1
   slicedir(1)      = 3
   slicecoord(1)    = 0.7853981633974483d0
 /

 &stoplist
   time_max         = 0.1d0
 /

 &methodlist
   time_stepper    = 'threestep'
   flux_scheme     = 20*'hll'
   limiter         = 20*'vanleer'
   phys            = 'hd'
 /

 &boundlist
   typeboundary_min1 = 5*'special'
   typeboundary_max1 = 5*'special'
   typeboundary_min2 = 5*'special'
   typeboundary_max2 = 5*'special'
   typeboundary_min3 = 5*'special'
   typeboundary_max3 = 5*'special'
   specialboundary   = .true.
 /

 &meshlist
   ! NOTE: angular coordinates are given in units of 2*pi, so theta runs over
   ! [pi/4, 3pi/4] and phi over [0, pi/2] below. The domain deliberately stays
   ! away from the polar axis and from r = 0.
   geometry           = 'spherical'
   max_blocks         =  4096
   refine_max_level   =  1
   block_nx1          =  8
   block_nx2          =  8
   block_nx3          =  8
   domain_nx1         =  16
   domain_nx2         =  16
   domain_nx3         =  16
   xprobmin1          =  1.0d0
   xprobmax1          =  2.0d0
   xprobmin2          =  0.125d0
   xprobmax2          =  0.375d0
   xprobmin3          =  0.0d0
   xprobmax3          =  0.25d0
 /

 &paramlist
   courantpar       = 0.4d0
 /

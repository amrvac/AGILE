 &usr_list
   ! Which initial condition this run uses; see mod_usr.fpp.
   ! Everything else about the build is shared with the other par
   ! files in this directory.
   setup = 'blast'
 /

 &filelist
   base_filename    = 'blast_amr'
   typefilelog      = 'regression_test'
   autoconvert      = F
 /

 &savelist
   dtsave_log       = 1e10
   dtsave_dat       = 1e10
 /

 &stoplist
   time_max         = 0.04d0
 /

 &methodlist
   time_stepper    = 'threestep'
   flux_scheme     = 20*'hll'
   limiter         = 20*'vanleer'
   phys            = 'hd'
 /

 &boundlist
   ! The r boundaries are ordinary open boundaries held at the exact solution.
   ! The axis faces are 'pole': read_par_files turns that into per-variable
   ! symm/asymm entries, and getbc fills those ghost cells from the block half
   ! a revolution away in phi rather than from a boundary condition. That only
   ! works if phi itself is periodic over a full turn, hence 'periodic' below.
   ! r = 0 is the axis; the other faces are open, as in the spherical blast.
   typeboundary_min1 = 5*'pole'
   typeboundary_max1 = 5*'cont'
   typeboundary_min2 = 5*'cont'
   typeboundary_max2 = 5*'cont'
   typeboundary_min3 = 5*'periodic'
   typeboundary_max3 = 5*'periodic'
 /

 &meshlist
   ! 3D cylindrical is (r, z, phi): only phi is angular, so only xprobmin3 and
   ! xprobmax3 are in units of 2*pi and the full turn below is [0, 2*pi]. r
   ! starts at 0, so this domain deliberately runs onto the cylindrical axis.
   ! The number of level-1 blocks across phi (domain_nx3/block_nx3 = 2) has to
   ! be even, because the block on the far side of the axis is found by
   ! shifting the phi block index by half of it.
   geometry           = 'cylindrical'
   max_blocks         =  4096
   ! Three levels, refined on density and energy, so that the shell is tracked
   ! at the finest level as it crosses the axis - which drives the restricting
   ! and prolonging pole paths on blocks that are regridded as the shock moves
   ! rather than on a static mesh.
   refine_max_level   =  3
   w_refine_weight    =  0.1d0, 0.0d0, 0.0d0, 0.0d0, 0.9d0
   block_nx1          =  8
   block_nx2          =  8
   block_nx3          =  8
   domain_nx1         =  16
   domain_nx2         =  16
   domain_nx3         =  16
   xprobmin1          =  0.0d0
   xprobmax1          =  1.0d0
   xprobmin2          =  0.0d0
   xprobmax2          =  1.0d0
   xprobmin3          =  0.0d0
   xprobmax3          =  1.0d0
 /

 &paramlist
   slowsteps        = 10
   courantpar       = 0.4d0
 /

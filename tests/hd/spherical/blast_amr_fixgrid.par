 &usr_list
   ! Which initial condition this run uses; see mod_usr.fpp.
   ! Everything else about the build is shared with the other par
   ! files in this directory.
   setup = 'blast'
 /

 &filelist
   base_filename    = 'blast_amr_fixgrid'
   typefilelog      = 'regression_test'
   autoconvert      = F
 /

 &savelist
   ! Several log lines rather than one: the signal this case exists for is the
   ! *drift* of mean(rho) over the run, so the time series is the measurement.
   dtsave_log       = 0.01d0
   dtsave_dat       = 1e10
 /

 &stoplist
   time_max         = 0.05d0
 /

 &methodlist
   time_stepper    = 'threestep'
   flux_scheme     = 20*'hll'
   limiter         = 20*'vanleer'
   phys            = 'hd'
 /

 &boundlist
   ! A *closed* domain, which is the whole point of this case: with no flux
   ! through any face, the volume average of rho that the regression log
   ! reports is the total mass, and has to stay at its initial 1.0 to
   ! round-off. Reflecting means symm for the scalars and asymm for the
   ! velocity component normal to the face; the variable order is
   ! rho, m_r, m_theta, m_phi, e.
   typeboundary_min1 = 'symm','asymm','symm','symm','symm'
   typeboundary_max1 = 'symm','asymm','symm','symm','symm'
   typeboundary_min2 = 'symm','symm','asymm','symm','symm'
   typeboundary_max2 = 'symm','symm','asymm','symm','symm'
   typeboundary_min3 = 'symm','symm','symm','asymm','symm'
   typeboundary_max3 = 'symm','symm','symm','asymm','symm'
 /

 &meshlist
   ! The refluxing test for a curvilinear grid, and the only case in the tree
   ! whose log fails loudly - by 4e-4 rather than in the last digits - when the
   ! flux correction at a refinement boundary is wrong or absent.
   !
   ! Two things make it sensitive where blast_amr.par is not. The domain is
   ! closed (see &boundlist), so mean(rho) is a conserved quantity and any
   ! mismatch between a coarse face flux and the four fine ones it faces shows
   ! up directly as mass appearing or disappearing. And itfixgrid = 0 freezes
   ! the mesh after the initial refinement, so the shell expands *through* the
   ! level jumps instead of dragging a refined, buffered region along with it.
   ! That second point is what blast_amr.par lacks: there the jumps always sit
   ! in still-uniform gas, where the coarse and fine fluxes agree exactly and
   ! refluxing has nothing to correct - its log does not move by so much as a
   ! digit whether the correction is applied or not.
   !
   ! Measured with the correction switched off in mod_advance: mass drifts by
   ! 7.3e-4 over this run. With it on: 4.2e-15, i.e. the round-off floor.
   !
   ! NOTE: angular coordinates (theta, phi here) are given in units of 2*pi,
   ! so theta runs over [pi/4, 3pi/4] and phi over [0, pi/2] below. The domain
   ! deliberately stays away from the polar axis and from r = 0.
   geometry           = 'spherical'
   max_blocks         =  4096

   refine_max_level   =  3
   w_refine_weight    =  0.1d0, 0.0d0, 0.0d0, 0.0d0, 0.9d0
   itfixgrid          =  0

   block_nx1          =  8
   block_nx2          =  8
   block_nx3          =  8
   domain_nx1         =  32
   domain_nx2         =  32
   domain_nx3         =  32
   xprobmin1          =  1.0d0
   xprobmax1          =  2.0d0
   xprobmin2          =  0.125d0
   xprobmax2          =  0.375d0
   xprobmin3          =  0.0d0
   xprobmax3          =  0.25d0
 /

 &paramlist
   slowsteps        = 10
   courantpar       = 0.4d0
 /

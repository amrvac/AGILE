 &usr_list
   ! Which initial condition this run uses; see mod_usr.fpp.
   ! Everything else about the build is shared with the other par
   ! files in this directory.
   setup = 'blast'
 /

 &filelist
   base_filename    = 'blast_amr'
   typefilelog      = 'regression_test'
   autoconvert      = F
 /

 &savelist
   dtsave_log       = 1e10
   dtsave_dat       = 1e10
 /

 &stoplist
   time_max         = 0.025d0
 /

 &methodlist
   time_stepper    = 'threestep'
   flux_scheme     = 20*'hll'
   limiter         = 20*'vanleer'
   phys            = 'hd'
 /

 &boundlist
   typeboundary_min1 = 5*'cont'
   typeboundary_max1 = 5*'cont'
   typeboundary_min2 = 5*'cont'
   typeboundary_max2 = 5*'cont'
   typeboundary_min3 = 5*'cont'
   typeboundary_max3 = 5*'cont'
 /

 &meshlist
   ! The AMR counterpart of tests/hd/spherical_blast, which runs the same
   ! problem on a single level. Everything below the refine_* block is
   ! identical to that case, so a diff of the two par files shows exactly what
   ! turning AMR on costs.
   !
   ! NOTE: angular coordinates (theta, phi here) are given in units of 2*pi,
   ! so theta runs over [pi/4, 3pi/4] and phi over [0, pi/2] below. The domain
   ! deliberately stays away from the polar axis and from r = 0.
   geometry           = 'spherical'
   max_blocks         =  4096

   ! Three levels, refined on density and energy by the default Lohner
   ! estimator (refine_criterion = 3). The expanding shell is a sharp feature
   ! that keeps moving outward in r, so the grid is re-made throughout the run
   ! rather than settling after the first regrid: that is what puts the
   ! curvilinear prolongation, coarsening and ghost-cell prolongation paths
   ! under test, none of which the single-level spherical_blast case reaches.
   refine_max_level   =  3
   w_refine_weight    =  0.1d0, 0.0d0, 0.0d0, 0.0d0, 0.9d0

   block_nx1          =  8
   block_nx2          =  8
   block_nx3          =  8
   domain_nx1         =  32
   domain_nx2         =  32
   domain_nx3         =  32
   xprobmin1          =  1.0d0
   xprobmax1          =  2.0d0
   xprobmin2          =  0.125d0
   xprobmax2          =  0.375d0
   xprobmin3          =  0.0d0
   xprobmax3          =  0.25d0
 /

 &paramlist
   slowsteps        = 10
   courantpar       = 0.4d0
 /

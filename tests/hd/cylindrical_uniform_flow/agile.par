 &filelist
   base_filename    = 'uflow'
   autoconvert      = T
   convert_type     = 'vtuBCCmpi'
   slice_type       = 'vtuCC'
   saveprim         = T
   ! nocartesian is .false. by default, so the VTU carries Cartesian cell
   ! corners and Cartesian vector components. For this case that is what you
   ! want to look at: v1/v2/v3 should come out as the constant Cartesian
   ! (1.0, 0.5, -0.3) everywhere, and rho as a flat 1.0. What is worth
   ! inspecting is where they fail to, i.e. where the truncation error lives.
 /

 &savelist
   itsave(1,2)      = 0        ! also dump the initial condition
   itsave(1,3)      = 0        ! ... and the initial slice
   ditsave_log      = 1        ! the per-step drift of mean(rho) is the point
   dtsave_dat       = 0.01d0
   dtsave_slice     = 0.01d0

   ! One z = const plane through the middle of the wedge.
   nslices          = 1
   slicedir(1)      = 2
   slicecoord(1)    = 0.5d0
 /

 &stoplist
   time_max         = 0.1d0
 /

 &methodlist
   time_stepper    = 'threestep'
   flux_scheme     = 20*'hll'
   limiter         = 20*'vanleer'
   phys            = 'hd'
 /

 &boundlist
   typeboundary_min1 = 5*'special'
   typeboundary_max1 = 5*'special'
   typeboundary_min2 = 5*'special'
   typeboundary_max2 = 5*'special'
   typeboundary_min3 = 5*'special'
   typeboundary_max3 = 5*'special'
   specialboundary   = .true.
 /

 &meshlist
   ! NOTE: phi (dim3) is given in units of 2*pi, so it runs over [0, pi/2]
   ! below; z (dim2) is a plain length. The domain deliberately stays away
   ! from the cylindrical axis r = 0.
   geometry           = 'cylindrical'
   max_blocks         =  4096
   refine_max_level   =  1
   block_nx1          =  8
   block_nx2          =  8
   block_nx3          =  8
   domain_nx1         =  16
   domain_nx2         =  16
   domain_nx3         =  16
   xprobmin1          =  1.0d0
   xprobmax1          =  2.0d0
   xprobmin2          =  0.0d0
   xprobmax2          =  1.0d0
   xprobmin3          =  0.0d0
   xprobmax3          =  0.25d0
 /

 &paramlist
   courantpar       = 0.4d0
 /

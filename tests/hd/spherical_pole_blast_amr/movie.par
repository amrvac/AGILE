! A longer, visualisable run of the same blast-across-the-pole setup as
! agile.par, for making a movie and for watching conservation.
!
! Two things differ from agile.par and test.par on purpose:
!
!  * the radial boundaries are reflecting walls rather than 'cont', so the
!    domain is sealed. Nothing can legitimately leave it, which is what makes
!    the volume averages in the log a conservation diagnostic: the total
!    volume is fixed, so mean(rho) and mean(e) are the total mass and total
!    energy up to that constant factor, and any drift in them is error. With
!    open boundaries the same numbers would simply track the flux out of the
!    domain and say nothing.
!
!  * it runs to t = 0.4, roughly half a sound-crossing time of the radial
!    domain (1.0 / sqrt(gamma*p0/rho0) = 0.77), which is long enough for the
!    shell to sweep across the pole, wrap around the far side and start
!    reflecting off the outer wall.
!
! Run it with, from this directory:
!   mkdir -p movie && mpirun -np 4 ./agile -i movie.par
!
! The .vtu snapshots are the 3D volumes and the slice files are the movie
! frames. Both carry Cartesian cell corners and Cartesian vector components
! (nocartesian is .false. by default), which is what ParaView and VisIt want
! for a full sphere.

 &filelist
   base_filename    = 'movie/poleblast'
   autoconvert      = T
   convert_type     = 'vtuBCCmpi'
   slice_type       = 'vtuCC'
   saveprim         = T
 /

 &savelist
   itsave(1,1)      = 0        ! also dump the initial log
   itsave(1,2)      = 0        ! ... the initial condition
   itsave(1,3)      = 0        ! ... and the initial slices
   ditsave_log      = 1        ! every step: this is the conservation trace
   dtsave_dat       = 0.01d0   ! 40 snapshots
   dtsave_slice     = 0.004d0  ! 100 movie frames

   ! Four slices. The two meridional half-planes at phi_c and phi_c + pi
   ! together make the full plane through the polar axis containing the blast
   ! centre - that is the view in which the shell is seen to cross the pole.
   ! The constant-r shell and the narrow cone show the same crossing from the
   ! other two directions.
   !
   ! CAUTION: unlike xprobmin2/xprobmax2 in &meshlist, slicecoord is in code
   ! units, so these angles are RADIANS. phi_c = 0.5*pi is the azimuth of the
   ! hot spot set in mod_usr.fpp; keep the two in step.
   nslices          = 4
   slicedir(1)      = 3
   slicecoord(1)    = 1.5707963267948966d0   ! phi = phi_c        = pi/2
   slicedir(2)      = 3
   slicecoord(2)    = 4.7123889803846899d0   ! phi = phi_c + pi   = 3pi/2
   slicedir(3)      = 1
   slicecoord(3)    = 1.0d0                  ! r = r_c, the shell of the spot
   slicedir(4)      = 2
   slicecoord(4)    = 0.1570796326794897d0   ! theta = 0.05*pi, close to the axis
 /

 &stoplist
   time_max         = 0.4d0
 /

 &methodlist
   time_stepper    = 'threestep'
   flux_scheme     = 20*'hll'
   limiter         = 20*'vanleer'
   phys            = 'hd'
 /

 &boundlist
   ! Reflecting walls in r: rho, m_theta, m_phi and e are symmetric, the
   ! normal momentum m_r is antisymmetric.  theta runs through both poles and
   ! phi is periodic over a full turn, exactly as in agile.par.
   typeboundary_min1 = 'symm','asymm','symm','symm','symm'
   typeboundary_max1 = 'symm','asymm','symm','symm','symm'
   typeboundary_min2 = 5*'pole'
   typeboundary_max2 = 5*'pole'
   typeboundary_min3 = 5*'periodic'
   typeboundary_max3 = 5*'periodic'
 /

 &meshlist
   geometry           = 'spherical'
   max_blocks         =  4096
   refine_max_level   =  3
   w_refine_weight    =  0.1d0, 0.0d0, 0.0d0, 0.0d0, 0.9d0
   block_nx1          =  8
   block_nx2          =  8
   block_nx3          =  8
   domain_nx1         =  16
   domain_nx2         =  16
   domain_nx3         =  16
   xprobmin1          =  0.5d0
   xprobmax1          =  1.5d0
   xprobmin2          =  0.0d0
   xprobmax2          =  0.5d0
   xprobmin3          =  0.0d0
   xprobmax3          =  1.0d0
 /

 &paramlist
   slowsteps        = 10
   courantpar       = 0.4d0
 /

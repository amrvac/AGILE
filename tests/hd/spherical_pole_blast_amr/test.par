 &filelist
   base_filename    = 'test'
   typefilelog      = 'regression_test'
   autoconvert      = F
 /

 &savelist
   dtsave_log       = 1e10
   dtsave_dat       = 1e10
 /

 &stoplist
   time_max         = 0.05d0
 /

 &methodlist
   time_stepper    = 'threestep'
   flux_scheme     = 20*'hll'
   limiter         = 20*'vanleer'
   phys            = 'hd'
 /

 &boundlist
   ! r is open at both ends. theta runs through both poles, and phi is
   ! periodic over a full turn, which is what set_pole needs before it will
   ! recognise the poles at all.
   typeboundary_min1 = 5*'cont'
   typeboundary_max1 = 5*'cont'
   typeboundary_min2 = 5*'pole'
   typeboundary_max2 = 5*'pole'
   typeboundary_min3 = 5*'periodic'
   typeboundary_max3 = 5*'periodic'
 /

 &meshlist
   ! NOTE: angular coordinates are given in units of 2*pi, so theta runs over
   ! the full [0, pi] and phi over the full [0, 2*pi]. The number of level-1
   ! blocks across phi (domain_nx3/block_nx3 = 2) has to be even, because the
   ! block on the far side of a pole is found by shifting the phi block index
   ! by half of it.
   !
   ! Three levels, refined on density and energy, so that the shell is tracked
   ! at the finest level as it crosses the axis - which is what drives the
   ! restricting and prolonging pole paths, on blocks that are regridded as
   ! the shock moves rather than on a static mesh.
   geometry           = 'spherical'
   max_blocks         =  4096
   refine_max_level   =  3
   w_refine_weight    =  0.1d0, 0.0d0, 0.0d0, 0.0d0, 0.9d0
   block_nx1          =  8
   block_nx2          =  8
   block_nx3          =  8
   domain_nx1         =  16
   domain_nx2         =  16
   domain_nx3         =  16
   xprobmin1          =  0.5d0
   xprobmax1          =  1.5d0
   xprobmin2          =  0.0d0
   xprobmax2          =  0.5d0
   xprobmin3          =  0.0d0
   xprobmax3          =  1.0d0
 /

 &paramlist
   slowsteps        = 10
   courantpar       = 0.4d0
 /

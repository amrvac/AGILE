{
  // Generated by tools/vscode/setup.sh -- re-run it rather than editing here.
  // What each block is for: tools/vscode/README.md

  // .fpp is not valid Fortran, so the linter runs fypp over it first and
  // gfortran over the result; fypp's line markers map errors back.
  "fortran.linter.compiler": "@LINTER@",
  "fortran.linter.fypp.enabled": true,
  // Absolute by necessity: the extension expands ${workspaceFolder} for every
  // other path setting, but hands this one straight to a PATH lookup.
  "fortran.linter.fypp.path": "@AGILE_DIR@/.venv/bin/fypp",
  "fortran.linter.fypp.includes": [
    "${workspaceFolder}/src"
  ],
  // Exactly one build gets linted. These two go together: the defines pick the
  // fypp branch, the module path must come from a build of that same branch.
  "fortran.linter.fypp.definitions": {
    "PHYS": "'hd'",
    "GEOM": "'Cartesian'"
  },
  "fortran.linter.includePaths": [
    "@MODULE_DIR@"
  ],
  // gfortran writes a .mod per module even with -fsyntax-only; keep them out
  // of the source tree.
  "fortran.linter.modOutput": "${workspaceFolder}/build/lint-mods",

  // fortls gives go-to-definition, hover and the outline. Its own diagnostics
  // are off because it cannot parse fypp directives either.
  "fortran.fortls.path": "${workspaceFolder}/.venv/bin/fortls",
  "fortran.fortls.disableDiagnostics": true,
  "fortran.fortls.excludeDirectories": [
    "**/build",
    "doc/ford/src",
    ".venv"
  ],

  "files.associations": {
    "*.make": "makefile",
    "*.mk": "makefile",
    "*.arch": "makefile"
  },

  // doc/code_style_guide.md
  "[FortranFreeForm]": {
    "editor.tabSize": 2,
    "editor.insertSpaces": true,
    "editor.detectIndentation": false
  }
}
